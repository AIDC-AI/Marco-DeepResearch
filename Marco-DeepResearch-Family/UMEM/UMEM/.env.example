# Required paths
MODEL_PATH=/path/to/policy-model
TRAIN_FILE_PATH=data/train.parquet
TEST_FILE_PATH=data/test.parquet
RETRIEVER_MODEL_PATH=/path/to/bge-m3

# OpenAI-compatible executor endpoint
EXECUTOR_API_URL=http://127.0.0.1:8000/v1/chat/completions
EXECUTOR_API_CODE=executor_llm
EXECUTOR_AK=EMPTY

# Experiment output
EXPERIMENT_NAME=umem_example
OUTPUT_BASE_DIR=./outputs

# Resources
N_GPUS=8
WORLD_SIZE=1

# Training hyperparameters
TRAIN_BATCH_SIZE=128
ROLLOUT_NUM=8
EPOCH=4
LR=1e-6
TAU=1.0
KL_W=0.001
USE_KL=true

# Retriever
RETRIEVER_ENABLE=true
RETRIEVER_USE_FP16=true
RETRIEVER_MAX_LENGTH=8196
RETRIEVER_BATCH_SIZE=4096
RETRIEVER_FAISS_GPU=false
RETRIEVER_TOPK=3
RETRIEVAL_THRESHOLD=0.5

# Executor generation
EXECUTOR_MAX_CONCURRENCY=512
EXECUTOR_TIMEOUT=1200
EXECUTOR_MAX_RETRIES=10
EXECUTOR_REPEAT_N=1
EXECUTOR_ENABLE_THINKING=false
EXECUTOR_MAX_INPUT_TOKENS=16384
EXECUTOR_MAX_TOKENS=16384
EXECUTOR_TEMPERATURE=0.0
EXECUTOR_TOP_P=0.8
EXECUTOR_TOP_K=20
EXECUTOR_MIN_P=0

# Reward configuration
EXTRACTOR_W_FORMAT=1.0
EXTRACTOR_W_QUALITY=1.0

# Optional
TRAINER_LOGGER="['console']"
PPO_MICRO_BATCH_SIZE_PER_GPU=4
ROLLOUT_TENSOR_MODEL_PARALLEL_SIZE=1
ROLLOUT_GPU_MEMORY_UTILIZATION=0.8
SAVE_FREQ=10
TEST_FREQ=20
# Rollout JSONL dumps are enabled by default under each experiment directory.
# Set this to an empty value in your shell to disable them.
# TRAINER_ROLLOUT_SAVE_DIR=
